{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@components/*": [
        "components/*"
      ],
      "@assets/*": [
        "assets/*"
      ],
      "@pages/*": [
        "views/*"
      ],
      "@styles/*": [
        "styles/*"
      ],
      "@locales/*": [
        "locales/*"
      ],
      "@constants/*": [
        "constants/*"
      ],
      "@layouts/*": [
        "layouts/*"
      ],
      "@models/*": [
        "@models/*"
      ],
      "@services/*": [
        "@services/*"
      ],
      "@redux/*": [
        "@redux/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "environment.d.ts", "utils/formatMoment.js", "components/WatchStoriesDialog/index.tsx", "utils/FileBase64Util.js", "modules/chat/index.js",
  ],
  "exclude": [
    "node_modules"
  ]
}